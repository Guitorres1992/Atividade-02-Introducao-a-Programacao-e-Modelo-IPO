programa
{
	funcao inicio()
	{
		inteiro x, y, z

		// Passo a passo do Teste de Mesa
		x = 10
		y = 4
		z = x + y * 2
		x = z - 6
		y = x % 5
		z = z + y - x

		// Exibindo os valores finais de x, y e z
		escreva(x, " ", y, " ", z, "\n")
	}
}
